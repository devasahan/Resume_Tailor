# Copy to .env and fill in only the providers you want to use.
# A model is available in the app only when its key variable is set.
# Use PAID keys: free-tier data may be used by the provider to improve its models.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZAI_API_KEY=
MOONSHOT_API_KEY=

# The admin account (History, Users, Settings). Type your own email and password here, never in the code.
# Restart the app after a change: a new ADMIN_PASSWORD replaces the old one and logs the admin out everywhere.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# On a server with HTTPS (PythonAnywhere) set both to 1: the session cookie travels only over HTTPS, and
# http:// visitors are sent to https://. Leave them empty on your own PC.
COOKIE_SECURE=
FORCE_HTTPS=
# Where the SQLite database lives.
DATA_DIR=./data
