<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ p.name }} - Cover Letter</title>
<style>
  @page { size: {{ paper }}; margin: 1in; }
  html { font-family: Calibri, Carlito, Arial, "Liberation Sans", Helvetica, sans-serif; font-size: 11pt; color: #000; }
  body { margin: 0; line-height: 1.35; }
  .name { font-size: 16pt; font-weight: bold; margin: 0; }
  .contact { margin: 2pt 0 14pt; }
  p { margin: 0 0 9pt; }
  .recipient { margin-bottom: 14pt; }
  .recipient p { margin: 0; }
</style>
</head>
<body>
  <p class="name">{{ p.name }}</p>
  {% if contact %}<p class="contact">{{ contact }}</p>{% endif %}
  <p>{{ today }}</p>
  {% if letter.hiring_manager or letter.company_name %}
  <div class="recipient">
    {% if letter.hiring_manager %}<p>{{ letter.hiring_manager }}</p>{% endif %}
    {% if letter.company_name %}<p>{{ letter.company_name }}</p>{% endif %}
  </div>
  {% endif %}
  <p>{{ letter.greeting }}</p>
  {% for paragraph in letter.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
  <p>{{ letter.closing }}</p>
  <p>{{ p.name }}</p>
</body>
</html>
