<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ p.name }} - Resume</title>
<style>
  @page { size: {{ style.paper }}; margin: {{ style.margin_in }}in; }
  html { font-family: Calibri, Carlito, Arial, "Liberation Sans", Helvetica, sans-serif; font-size: {{ style.font_pt }}pt; color: #000; }
  body { margin: 0; line-height: 1.27; }
  h1 { font-size: {{ style.font_pt + 9 }}pt; margin: 0; text-align: center; letter-spacing: 0.4pt; }
  .contact { text-align: center; margin-top: 2pt; }
  .headline { text-align: center; font-weight: bold; margin-top: 4pt; }
  h2 { font-size: {{ style.font_pt + 0.5 }}pt; margin: 8pt 0 3pt; padding-bottom: 1pt; border-bottom: 0.75pt solid #000; letter-spacing: 0.6pt; }
  p { margin: 0; }
  .row { display: flex; justify-content: space-between; align-items: baseline; }
  .dates { white-space: nowrap; margin-left: 10pt; }
  .job { margin-top: 4pt; }
  .job:first-of-type { margin-top: 0; }
  ul { margin: 1.5pt 0 0 13pt; padding: 0; }
  li { margin: 0 0 1pt; }
  .skills p { margin-bottom: 1pt; }
  a { color: #000; text-decoration: none; }
</style>
</head>
<body>
  <h1>{{ p.name }}</h1>
  {% if contact %}<p class="contact">{{ contact }}</p>{% endif %}
  <p class="headline">{{ resume.headline }}</p>

  <h2>SUMMARY</h2>
  <p>{{ resume.summary }}</p>

  <h2>SKILLS</h2>
  <div class="skills">
    {% for group in resume.skills %}
    <p><b>{{ group.category }}:</b> {{ group.items | join(", ") }}</p>
    {% endfor %}
  </div>

  <h2>EXPERIENCE</h2>
  {% for exp in resume.experience %}
  {% set c = p.companies[exp.company_index] %}
  <div class="job">
    <div class="row">
      <span><b>{{ exp.job_title }}</b> | {{ c.name }}{% if c.location %} | {{ c.location }}{% endif %}{% if c.mode %} | {{ c.mode }}{% endif %}</span>
      <span class="dates">{{ dates(c.start, c.end) }}</span>
    </div>
    <ul>
      {% for bullet in exp.bullets %}<li>{{ bullet }}</li>{% endfor %}
    </ul>
  </div>
  {% endfor %}

  {% if p.education %}
  <h2>EDUCATION</h2>
  {% for e in p.education %}
  <div class="row">
    <span><b>{{ [e.degree, e.field] | select | join(", ") or e.school }}</b>{% if e.degree or e.field %} | {{ e.school }}{% endif %}</span>
    <span class="dates">{{ dates(e.start, e.end) }}</span>
  </div>
  {% if e.details %}<p>{{ e.details }}</p>{% endif %}
  {% endfor %}
  {% endif %}
</body>
</html>
